@@ -163,6 +163,13 @@ public class ImagePickerModule: Module, OnMediaPickingResultHandler {
   }
 
   private func presentPickerUI(_ picker: PickerUIController, pickingContext context: PickingContext) {
+    // Overwriting an in-flight context would deallocate the visible picker's
+    // (weakly referenced) delegate, leaving it stuck on screen with dead
+    // buttons and a promise that never settles. Treat the overlap as a cancel.
+    guard self.currentPickingContext == nil else {
+      return context.promise.resolve(ImagePickerResponse(assets: nil, canceled: true))
+    }
+
     guard let currentViewController = self.appContext?.utilities?.currentViewController() else {
       return context.promise.reject(MissingCurrentViewControllerException())
     }
